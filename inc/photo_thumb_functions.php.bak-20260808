<?php
# geeft de thumb-url voor een foto terug.
# de thumb wordt normaal al aangemaakt bij upload (api/post/upload.php),
# maar voor oudere foto's die dat nog niet hebben wordt hij hier alsnog on-the-fly aangemaakt.
function get_photo_thumb_url ( $event_id, $file_hash )
	{
	global $timer;
	if ( !is_array ( $timer ) ) { $timer = array(); }
	if ( !isset ( $timer['photo_thumb_on_the_fly_count'] ) ) { $timer['photo_thumb_on_the_fly_count'] = 0; }
	if ( !isset ( $timer['photo_thumb_on_the_fly_time']  ) ) { $timer['photo_thumb_on_the_fly_time']  = 0; }

	$base_dir    = "/home/magicshoot/domains/magicshoot.nl/public_html/api/event/media/photos/" . $event_id;
	$source_path = $base_dir . "/" . $file_hash . ".jpg";
	$thumb_dir   = $base_dir . "/thumbs";
	$thumb_path  = $thumb_dir . "/" . $file_hash . ".jpg";

	if ( is_file ( $thumb_path ) == false && is_file ( $source_path ) )
		{
		$time = -microtime(true);
		if ( is_dir ( $thumb_dir ) == false )
			{
			mkdir ( $thumb_dir );
			chmod ( $thumb_dir, 0777 );
			}
		create_photo_thumb ( $event_id, $source_path, $thumb_path );
		$timer['photo_thumb_on_the_fly_count']++;
		$timer['photo_thumb_on_the_fly_time'] += $time += microtime(true);
		}

	# cache-buster: voorkomt dat browsers/CDN een verouderde (bv. verkeerd geformateerde) thumb blijven tonen na regeneratie
	$cache_buster = is_file ( $thumb_path ) ? filemtime ( $thumb_path ) : time();

	return "https://api.magicshoot.nl/event/media/photos/" . $event_id . "/thumbs/" . $file_hash . ".jpg?v=" . $cache_buster;
	}

function create_photo_thumb ( $event_id, $sImagePath, $thumbPath )
	{
	# event_id 35, 83 en 115 zijn oudere/afwijkende opstellingen (geen fotokast): schaal-thumb ipv vaste 842x280 crop
	$event_ids_afwijkend_formaat = array( 35, 83, 115 );

	$sExtension = @strtolower ( end ( explode ( '.', $sImagePath ) ) );

	if ( $sExtension == 'jpg' || $sExtension == 'jpeg' )
		{
		$img = @imagecreatefromjpeg ( $sImagePath );
		}
	else if ( $sExtension == 'png' )
		{
		$img = @imagecreatefrompng ( $sImagePath );
		}
	else if ( $sExtension == 'gif' )
		{
		$img = @imagecreatefromgif ( $sImagePath );
		}
	else
		{
		$img = false;
		}

	if ( $img )
		{
		$iOrigWidth  = imagesx ( $img );
		$iOrigHeight = imagesy ( $img );

		if ( in_array ( $event_id, $event_ids_afwijkend_formaat ) )
			{
			# schaal-thumb, behoud aspect ratio, max 400px
			$iMaxDim = 400;
			$fScale  = min ( $iMaxDim / $iOrigWidth, $iMaxDim / $iOrigHeight, 1 );

			$iNewWidth  = max ( 1, floor ( $fScale * $iOrigWidth  ) );
			$iNewHeight = max ( 1, floor ( $fScale * $iOrigHeight ) );

			$tmpimg = imagecreatetruecolor ( $iNewWidth, $iNewHeight );
			imagecopyresampled ( $tmpimg, $img, 0, 0, 0, 0, $iNewWidth, $iNewHeight, $iOrigWidth, $iOrigHeight );
			imagedestroy ( $img );

			imagejpeg ( $tmpimg, $thumbPath, 82 );
			imagedestroy ( $tmpimg );
			}
		else
			{
			# fotokast: schaal-thumb binnen 240x842, behoud aspect ratio (geen crop, anders vallen
			# strook-randen zoals het groene kader weg als de bron-aspect niet exact 240:842 is)
			$iThumbnailWidth  = 240;
			$iThumbnailHeight = 842;
			$fScale = min ( $iThumbnailWidth / $iOrigWidth, $iThumbnailHeight / $iOrigHeight, 1 );

			$iNewWidth  = max ( 1, (int) floor ( $fScale * $iOrigWidth  ) );
			$iNewHeight = max ( 1, (int) floor ( $fScale * $iOrigHeight ) );

			$tmpimg = imagecreatetruecolor ( $iNewWidth, $iNewHeight );
			imagecopyresampled ( $tmpimg, $img, 0, 0, 0, 0, $iNewWidth, $iNewHeight, $iOrigWidth, $iOrigHeight );
			imagedestroy ( $img );

			imagejpeg ( $tmpimg, $thumbPath, 83 );
			imagedestroy ( $tmpimg );
			}
		}
	}
?>
